# Worker runtime only. Copy to `.env.worker.local`; never add API, JWT, MFA,
# email or migrator credentials. Values below are placeholders, not secrets.
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=balanz_dev
DB_WORKER_USERNAME=balanz_worker_login
DB_WORKER_PASSWORD=
DB_LOGGING=false
DB_CONNECTION_TIMEOUT_MS=2000

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_WAKEUP_ENABLED=true
REDIS_WAKEUP_PREFIX=balanz:ingestion:wakeup

OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=.local/fiscal-object-storage
# Set true only after the documented Windows ACL preflight succeeds.
OBJECT_STORAGE_LOCAL_WINDOWS_PRESECURED=false
MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310

WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=4
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_SECONDS=10,30,120
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

SECRETS_ENABLED=false
SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=balanz
# Keep the existing Vault taxonomy unless deployment has provisioned another.
SECRETS_SYSTEM=api
VAULT_BASE_URL=https://vault.hemia.dev
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# See `.env.example` for the remaining non-secret fiscal safety controls.
