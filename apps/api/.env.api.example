# API runtime only. Copy to `.env.api.local`; never add worker or migrator
# credentials. Values below are placeholders and are not secrets.
NODE_ENV=development
APP_PORT=3001
APP_GLOBAL_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=balanz_dev
DB_API_USERNAME=balanz_api_login
DB_API_PASSWORD=
DB_LOGGING=false
DB_CONNECTION_TIMEOUT_MS=2000

JWT_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=12

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SECRETS_ENABLED=false
SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=balanz
SECRETS_SYSTEM=api
VAULT_BASE_URL=https://vault.hemia.dev
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# See `.env.example` for non-secret fiscal controls and API email/auth options.
