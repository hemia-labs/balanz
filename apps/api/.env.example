# Catálogo completo para tooling explícito. No lo copies íntegro a un runtime:
# usa `.env.api.example` -> `.env.api.local` para API y
# `.env.worker.example` -> `.env.worker.local` para worker. Cada entrypoint
# rechaza configuración/credenciales pertenecientes al otro proceso.

# App (API only)
NODE_ENV=development
APP_PORT=3021
APP_GLOBAL_PREFIX=api/v1
# CSV de origins HTTP(S) exactos, sin credenciales/path/query/hash; vacío usa localhost sólo en dev.
APP_CORS_ORIGINS=http://localhost:5181
# Número explícito de proxies confiables delante de Express (0 = ninguno).
TRUST_PROXY_HOPS=0

# Horus (si HORUS_URL y HORUS_KEY están ambas vacías, la captura queda desactivada)
HORUS_URL=
HORUS_KEY=
HORUS_RELEASE=
HORUS_TIMEOUT_MS=2000

# Database connectivity shared by CLI/API/worker when Vault is disabled.
DB_HOST=localhost
DB_PORT=5432
# Migrator only: release/migration/seed/provisioning scripts. API and worker
# reject these values and never materialize them in ConfigService.
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false
# Bounds PostgreSQL pool acquisition; must not exceed HEALTH_CHECK_TIMEOUT_MS.
DB_CONNECTION_TIMEOUT_MS=2000
# Runtime roles are provisioned separately and must be NOBYPASSRLS/NOSUPERUSER.
# Never reuse DB_USERNAME (the migrator credential) for these processes.
DB_API_USERNAME=
DB_API_PASSWORD=
DB_WORKER_USERNAME=
DB_WORKER_PASSWORD=
# QA-only double gate; never enable on an API/worker runtime process.
CFDI_PHASE0_TEST_DATABASE=balanz_cfdi_phase0_test
CFDI_PHASE0_USE_TEST_DATABASE=false
QA_ALLOW_TRANSACTIONAL_MIGRATION_DOWN_UP=false
QA_ALLOW_FISCAL_RUNTIME_VALIDATION=false
# Dev/test-only explicit gate for `npm run db:runtime:provision`.
CFDI_PROVISION_RUNTIME_LOGINS=false

# Auth (API only; worker rejects this entire section).
# JWT secrets de mínimo 16 caracteres; genera unos propios en prod.
# Solo se usan cuando SECRETS_ENABLED=false.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_TTL_MINUTES=30
TRIAL_DURATION_DAYS=30

# Redis session cache (si no hay config usable, se usa PostgreSQL)
# REDIS_ENABLED=false desactiva Redis explícitamente; por defecto intenta Vault o REDIS_*.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=balanz:
REDIS_CONNECT_TIMEOUT_MS=1000
# Best-effort wakeup only; PostgreSQL polling remains authoritative.
REDIS_WAKEUP_ENABLED=true
REDIS_WAKEUP_PREFIX=balanz:ingestion:wakeup
REDIS_WAKEUP_TIMEOUT_MS=500

# CFDI Phase 0 — object storage. Local is development-only and remains outside public/.
OBJECT_STORAGE_DRIVER=local
# Relative paths resolve from the repository root, independent of process cwd.
OBJECT_STORAGE_LOCAL_ROOT=.local/fiscal-object-storage
# Windows only: true attests that this dedicated root already has a private
# NTFS DACL. The adapter rejects Windows local storage by default.
OBJECT_STORAGE_LOCAL_WINDOWS_PRESECURED=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=60
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-2
S3_BUCKET=balanz-cfdi-phase0-test
S3_FORCE_PATH_STYLE=true
# Production requires aws:kms plus S3_KMS_KEY_ID; MinIO development uses AES256.
S3_SSE_MODE=AES256
S3_KMS_KEY_ID=
# Development/MinIO only. Production should use IAM/Vault rather than static env credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_MS=10000

# CFDI Phase 0 — malware scanning. Bypass must be explicitly selected and is dev-only.
MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
CLAMAV_CONNECT_TIMEOUT_MS=2000
CLAMAV_SCAN_TIMEOUT_MS=30000
CLAMAV_MAX_STREAM_BYTES=52428800

# CFDI Phase 0 — durable worker (locked safety timings; harmless controls may
# also be loaded by API, but only the worker executes them).
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=10,30,120
WORKER_BACKOFF_JITTER_PERCENT=20
WORKER_POLL_INTERVAL_MS=5000
WORKER_RECONCILE_INTERVAL_MS=60000
WORKER_SHUTDOWN_GRACE_MS=30000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

# Retention and foundational safety limits. ZIP values are reserved for Phase 2.
INGESTION_INCOMPLETE_UPLOAD_HOURS=24
INGESTION_DUPLICATE_BYTES_HOURS=24
INGESTION_ORPHAN_GRACE_MINUTES=60
INGESTION_INVALID_OBJECT_DAYS=7
INGESTION_MALWARE_QUARANTINE_DAYS=7
INGESTION_COMPLETED_OBJECT_DAYS=30
INGESTION_XML_MAX_BYTES=5242880
INGESTION_DIRECT_XML_MAX_COUNT=1
INGESTION_ZIP_MAX_BYTES=52428800
INGESTION_ZIP_MAX_ENTRIES=2000
INGESTION_ZIP_MAX_UNCOMPRESSED_BYTES=262144000
INGESTION_ZIP_MAX_COMPRESSION_RATIO=50
INGESTION_ZIP_MAX_DEPTH=2
INGESTION_ZIP_MAX_PATH_CHARACTERS=240
INGESTION_ZIP_ALLOW_NESTED=false
INGESTION_ZIP_ALLOW_ENCRYPTED=false
INGESTION_ZIP_ALLOW_LINKS=false
INGESTION_XML_MAX_DEPTH=64
INGESTION_XML_MAX_NODES=200000
INGESTION_XML_MAX_ATTRIBUTES=100000
INGESTION_XML_MAX_ATTRIBUTES_PER_ELEMENT=128
INGESTION_XML_MAX_TEXT_NODE_BYTES=1048576
INGESTION_XML_PARSE_TIMEOUT_MS=5000
WORKER_MEMORY_TARGET_MIB=256
INGESTION_ACTIVE_JOBS_PER_USER=2
INGESTION_ACTIVE_JOBS_PER_TENANT=4
METRICS_ENABLED=true
METRICS_PATH=/metrics
HEALTH_CHECK_TIMEOUT_MS=2000

# Email (API only; worker rejects EMAIL_*). Con Vault habilitado, región y
# credenciales vienen de email/ses. AWS_REGION may also serve S3 and is shared.
AWS_REGION=us-east-2
EMAIL_PROJECT=cfdios
EMAIL_ENVIRONMENT=dev
EMAIL_FROM_NAME=Balanz
EMAIL_FROM_AUTH=auth@cfdios.hemia.dev
EMAIL_FROM_NOTIFICATIONS=notifications@cfdios.hemia.dev
EMAIL_REPLY_TO=support@hemia.dev
EMAIL_CONFIGURATION_SET_AUTH=hemia-dev-auth
EMAIL_CONFIGURATION_SET_TRANSACTIONAL=hemia-dev-transactional
EMAIL_VERIFICATION_TEMPLATE=cfdios-dev-email-verification
EMAIL_WELCOME_TEMPLATE=cfdios-dev-welcome
EMAIL_MFA_ENABLED_TEMPLATE=cfdios-dev-mfa-enabled
EMAIL_MFA_DISABLED_TEMPLATE=cfdios-dev-mfa-disabled
EMAIL_PASSWORD_RESET_TEMPLATE=cfdios-dev-forgot-password
EMAIL_APP_NAME=Balanz
EMAIL_APP_SUBTITLE=Contable
EMAIL_APP_URL=http://localhost:5181
EMAIL_ASSETS_BASE_URL=https://cdn.hemia.dev
EMAIL_ICON_EMAIL_URL=https://cdn.hemia.dev/icon-email.png
EMAIL_SUPPORT_EMAIL=soporte@balanz.mx
EMAIL_HELP_URL=https://app.balanz.mx/ayuda
EMAIL_PRIVACY_URL=https://app.balanz.mx/privacidad
EMAIL_TERMS_URL=https://app.balanz.mx/terminos
EMAIL_COMPANY_ADDRESS=Av. Reforma 123, Ciudad de México, México

# Auth sessions / TOTP local (API only)
AUTH_SESSION_COOKIE_NAME=balanz_session
AUTH_SESSION_TTL_SECONDS=28800
# Debe ser mayor que AUTH_SESSION_ACTIVITY_PERSIST_INTERVAL_SECONDS.
AUTH_SESSION_IDLE_TTL_SECONDS=1800
# Debe ser estrictamente menor que AUTH_SESSION_IDLE_TTL_SECONDS.
AUTH_SESSION_ACTIVITY_PERSIST_INTERVAL_SECONDS=300
# Base64 de 32 bytes; en producción se obtiene desde el almacén de secretos.
MFA_ENCRYPTION_KEY=
AUTH_VERIFICATION_RESEND_LIMIT=3
AUTH_VERIFICATION_RESEND_WINDOW_SECONDS=900
AUTH_VERIFICATION_REGISTER_LIMIT=3
AUTH_VERIFICATION_REGISTER_WINDOW_SECONDS=900
AUTH_VERIFICATION_CONFIRM_LIMIT=5
AUTH_VERIFICATION_CONFIRM_WINDOW_SECONDS=300
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_PASSWORD_RESET_REQUEST_LIMIT=3
AUTH_PASSWORD_RESET_REQUEST_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_CONFIRM_LIMIT=5
AUTH_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=300
AUTH_MFA_VERIFY_LIMIT=5
AUTH_MFA_VERIFY_WINDOW_SECONDS=300
AUTH_THROTTLER_LIMIT=60
AUTH_THROTTLER_TTL_MS=60000
AUTH_THROTTLER_BLOCK_DURATION_MS=60000

# true solo detrás de HTTPS (cookies Secure)
COOKIE_SECURE=false
# strict/lax para desarrollo; none requiere COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12

# Secrets (Vault KV v2). DB paths: database/postgres sólo para el release job;
# database/postgres-api y database/postgres-worker para runtimes separados.
SECRETS_ENABLED=false
# Production with secrets enabled requires the explicit `prod` scope.
SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=balanz
# Existing dev Vault taxonomy is `api`; production must set the deployed
# taxonomy explicitly. Separation comes from per-process AppRole policy and
# runtime paths, not from assuming a new Vault namespace.
SECRETS_SYSTEM=api
SECRETS_CACHE_ENABLED=true
SECRETS_CACHE_TTL_MS=60000

VAULT_BASE_URL=https://vault.hemia.dev
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_AUTH_PATH=approle
VAULT_MOUNT_PREFIX=kv-
VAULT_TIMEOUT_MS=5000
