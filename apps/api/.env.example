# App
NODE_ENV=development
APP_PORT=3001
APP_GLOBAL_PREFIX=api/v1
# CSV de orígenes permitidos; vacío = CORS abierto (solo dev)
APP_CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

# Auth (JWT) — secrets de mínimo 16 caracteres; genera unos propios en prod
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# true solo detrás de HTTPS (cookies Secure)
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12
