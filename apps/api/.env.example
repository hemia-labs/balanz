# App
NODE_ENV=development
APP_PORT=3001
APP_GLOBAL_PREFIX=api/v1
# CSV de orígenes permitidos; vacío usa http://localhost:3000 sólo en dev.
APP_CORS_ORIGINS=http://localhost:3000
# Número explícito de proxies confiables delante de Express (0 = ninguno).
TRUST_PROXY_HOPS=0

# Database (fallback cuando SECRETS_ENABLED=false)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

# Auth (JWT) — secrets de mínimo 16 caracteres; genera unos propios en prod
# Solo se usan cuando SECRETS_ENABLED=false.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_TTL_MINUTES=30
TRIAL_DURATION_DAYS=30

# Redis session cache (si no hay config usable, se usa PostgreSQL)
# REDIS_ENABLED=false desactiva Redis explícitamente; por defecto intenta Vault o REDIS_*.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=balanz:
REDIS_CONNECT_TIMEOUT_MS=1000
AUTH_SESSION_ACTIVITY_PERSIST_INTERVAL_SECONDS=300

# Email (SESv2). Con Vault habilitado, región y credenciales vienen de email/ses.
AWS_REGION=us-east-2
EMAIL_PROJECT=cfdios
EMAIL_ENVIRONMENT=dev
EMAIL_FROM_NAME=CFDIOS
EMAIL_FROM_AUTH=auth@cfdios.hemia.dev
EMAIL_FROM_NOTIFICATIONS=notifications@cfdios.hemia.dev
EMAIL_REPLY_TO=support@hemia.dev
EMAIL_CONFIGURATION_SET_AUTH=hemia-dev-auth
EMAIL_CONFIGURATION_SET_TRANSACTIONAL=hemia-dev-transactional
EMAIL_VERIFICATION_TEMPLATE=cfdios-dev-email-verification
EMAIL_WELCOME_TEMPLATE=cfdios-dev-welcome
EMAIL_MFA_ENABLED_TEMPLATE=cfdios-dev-mfa-enabled
EMAIL_MFA_DISABLED_TEMPLATE=cfdios-dev-mfa-disabled
EMAIL_APP_NAME=Balanz
EMAIL_APP_SUBTITLE=Contable
EMAIL_APP_URL=http://localhost:3000
EMAIL_ASSETS_BASE_URL=https://cdn.hemia.dev
EMAIL_SUPPORT_EMAIL=soporte@balanz.mx
EMAIL_HELP_URL=https://app.balanz.mx/ayuda
EMAIL_PRIVACY_URL=https://app.balanz.mx/privacidad
EMAIL_TERMS_URL=https://app.balanz.mx/terminos
EMAIL_COMPANY_ADDRESS=

# Auth sessions / TOTP local
AUTH_SESSION_COOKIE_NAME=balanz_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_IDLE_TTL_SECONDS=1800
# Base64 de 32 bytes; en producción se obtiene desde el almacén de secretos.
MFA_ENCRYPTION_KEY=
AUTH_VERIFICATION_RESEND_LIMIT=3
AUTH_VERIFICATION_RESEND_WINDOW_SECONDS=900
AUTH_VERIFICATION_REGISTER_LIMIT=3
AUTH_VERIFICATION_REGISTER_WINDOW_SECONDS=900
AUTH_VERIFICATION_CONFIRM_LIMIT=5
AUTH_VERIFICATION_CONFIRM_WINDOW_SECONDS=300
AUTH_MFA_VERIFY_LIMIT=5
AUTH_MFA_VERIFY_WINDOW_SECONDS=300
AUTH_THROTTLER_LIMIT=60
AUTH_THROTTLER_TTL_MS=60000
AUTH_THROTTLER_BLOCK_DURATION_MS=60000

# true solo detrás de HTTPS (cookies Secure)
COOKIE_SECURE=false
# strict/lax para desarrollo; none requiere COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12

# Secrets (Vault KV v2). Paths lógicos: auth/jwt, database/postgres, email/ses y cache/redis.
SECRETS_ENABLED=false
SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=balanz
SECRETS_SYSTEM=api
SECRETS_CACHE_ENABLED=true
SECRETS_CACHE_TTL_MS=60000

VAULT_BASE_URL=https://vault.hemia.dev
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_AUTH_PATH=approle
VAULT_MOUNT_PREFIX=kv-
VAULT_TIMEOUT_MS=5000
