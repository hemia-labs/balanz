{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:api": "nest start --entryFile main",
    "start:api:dev": "nest start --watch --entryFile main",
    "start:api:prod": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/database/migrations/Migration",
    "migration:preflight": "ts-node --transpile-only src/database/scripts/preflight-fiscal-foundation.ts",
    "migration:show": "ts-node --transpile-only src/database/scripts/show-migrations.ts",
    "migration:run": "ts-node --transpile-only src/database/scripts/run-migrations.ts",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "seed:run": "ts-node --transpile-only src/database/seeds/run-seeds.ts",
    "qa:migrations": "ts-node --transpile-only test/validate-migration-lifecycle.ts",
    "test:integration:fiscal": "ts-node --transpile-only test/validate-fiscal-foundation-transaction.ts",
    "test:integration:fiscal:runtime": "ts-node --transpile-only test/validate-fiscal-foundation-runtime.ts",
    "test:external:fiscal": "jest --testRegex=\"test/external/.*\\.external\\.ts$\" --runInBand",
    "db:test:prepare": "ts-node --transpile-only src/database/scripts/prepare-fiscal-test-database.ts",
    "db:runtime:provision": "ts-node --transpile-only src/database/scripts/provision-fiscal-runtime-logins.ts",
    "qa:cfdi:postgres": "npm run migration:show && npm run migration:preflight && npm run migration:run && npm run seed:run && npm run seed:run && npm run qa:migrations && npm run test:integration:fiscal && npm run test:integration:fiscal:runtime",
    "maintenance:auth-cleanup": "ts-node --transpile-only src/database/maintenance/cleanup-auth-data.ts",
    "db:prepare": "npm run migration:preflight && npm run migration:run && npm run seed:run",
    "release:prepare": "npm run db:prepare"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@aws-sdk/lib-storage": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@hemia/horus": "^0.0.5",
    "@hemia/secrets": "^0.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.2",
    "@smithy/node-http-handler": "4.11.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "joi": "^18.2.3",
    "otplib": "^13.5.0",
    "pg": "^8.21.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
