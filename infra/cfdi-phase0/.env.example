# Copy to .env and replace the two development-only example secrets.
POSTGRES_DB=balanz_cfdi_phase0_test
POSTGRES_USER=balanz_cfdi_admin
POSTGRES_PASSWORD=replace-with-a-local-test-password
POSTGRES_PORT=55432

REDIS_PORT=56379

MINIO_ROOT_USER=balanz_phase0
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_KMS_SECRET_KEY=balanz-phase0:replace-with-a-base64-encoded-32-byte-key
MINIO_APP_USER=balanz_cfdi_app
MINIO_APP_PASSWORD=replace-with-a-distinct-local-app-password
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_SSE_MODE=AES256

CLAMAV_PORT=53310
